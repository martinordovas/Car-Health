# Copia este archivo como .env y cambia los secretos antes de desplegar.
# Genera secretos fuertes con: openssl rand -base64 48

POSTGRES_DB=carhealth
POSTGRES_USER=carhealth
POSTGRES_PASSWORD=cambia-esta-contraseña-larga-y-única
JWT_SECRET=cambia-este-secreto-jwt-por-uno-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION_DAYS=30

# En local con Caddy por HTTP:
SITE_ADDRESS=http://localhost
# En producción con dominio y SSL automático:
# SITE_ADDRESS=carhealth.tudominio.com

# Deja false en producción. Si lo pones a true, se crea el usuario demo@carhealth.app / demo1234.
DEMO_DATA=false

# Ponlo a false si no quieres exponer Swagger/OpenAPI públicamente.
SPRINGDOC_ENABLED=true

# Orígenes permitidos por CORS si algún día sirves el frontend en otro dominio.
CORS_ORIGINS=http://localhost

# Correo de verificación.
# En local, si MAIL_ENABLED=false, el código se escribe en el log del backend.
# En producción, activa SMTP con las credenciales de tu proveedor (Brevo, Resend, SES, Mailgun…).
MAIL_ENABLED=false
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=Car Health

# --- Mailpit para desarrollo local ---
# Arranca Mailpit con ./scripts/mailpit.sh (o con
# docker compose --profile mail up -d mailpit).
# Para usarlo, sustituye el bloque de correo de arriba por estas variables.
# Si el backend corre en tu máquina:
# MAIL_ENABLED=true
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_SMTP_SSL=false
# MAIL_FROM=no-reply@carhealth.local
# MAIL_FROM_NAME=Car Health
#
# Si el backend corre dentro de Docker Compose, cambia MAIL_HOST por:
# MAIL_HOST=mailpit
