# Copia este archivo como .env y cambia los secretos antes de desplegar.
# Genera secretos fuertes con: openssl rand -base64 48

POSTGRES_DB=carhealth
POSTGRES_USER=carhealth
POSTGRES_PASSWORD=cambia-esta-contraseña-larga-y-única
JWT_SECRET=cambia-este-secreto-jwt-por-uno-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION_DAYS=30

# En local con Caddy por HTTP:
SITE_ADDRESS=http://localhost
# En producción con dominio y SSL automático:
# SITE_ADDRESS=carhealth.tudominio.com

# Deja false en producción. Si lo pones a true, se crea el usuario demo@carhealth.app / demo1234.
DEMO_DATA=false

# Ponlo a false si no quieres exponer Swagger/OpenAPI públicamente.
SPRINGDOC_ENABLED=true

# Orígenes permitidos por CORS si algún día sirves el frontend en otro dominio.
CORS_ORIGINS=http://localhost
